# ==============================================================================
# IndicRAG — Environment Configuration
# Copy this file to .env and fill in the required values.
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
#
# NEVER commit .env to version control — it contains secrets.
# ==============================================================================


# ==============================================================================
# HuggingFace Hub (Optional)
# ==============================================================================
# Models (BGE-M3, reranker, NLI) are cached locally after first download. Set
# offline mode to skip HF Hub update checks on startup (faster, no HTTP log
# noise). Only enable AFTER all models are cached, or startup will fail.
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1


# ==============================================================================
# LLM — Google Gemini (REQUIRED)
# ==============================================================================

# Get your API key at: https://aistudio.google.com/app/apikey
#
# Option 1: Single key
LLM_API_KEY=your-gemini-api-key-here
#
# Option 2: Multiple keys for load balancing (round-robin).
# The agentic pipeline makes many Gemini calls per query — multiple keys
# distribute the load and avoid per-key rate limits.
# When LLM_API_KEYS is set, LLM_API_KEY is ignored.
# LLM_API_KEYS=key-one,key-two,key-three

# Model to use for answer generation.
# Recommended: gemini-3.6-flash — latest Gemini Flash, fast, cost-effective.
# Alternatives:
#   gemini-3.5-flash         Previous generation, stable and proven
#   gemini-3-flash-preview   Preview alias (same model)
#   gemini-2.5-pro           Higher reasoning quality, slower and more expensive
LLM_MODEL_NAME=gemini-3.6-flash
# Fallback model when primary is overloaded (503/429)
LLM_FALLBACK_MODEL=gemma-4-26b-a4b-it

# Response generation parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
AGENT_MAX_TOKENS=8192
AGENT_TIMEOUT=120
# Thinking budget: 0=off (cheapest), -1=dynamic, N=cap N thinking tokens.
# Note: some models (e.g. gemini-3.6-flash) reject a literal 0 budget. The
# Gemini backend detects that once per model and omits the field instead, so
# 0 stays safe — it just means "no thinking config" on those models.
AGENT_THINKING_BUDGET=0
# Max sub-queries per reflexion cycle (main agent-latency lever)
AGENT_MAX_SUB_QUERIES=3
# Wall-clock budget for the reflexion loop (seconds). Once exceeded, the
# evaluator finalizes the current draft instead of starting another
# retrieve -> generate -> verify cycle. Keep BELOW AGENT_TIMEOUT so it fires
# first and the user gets an answer rather than a 504 that discards the work.
AGENT_REFLEXION_BUDGET_S=90
# Context caps for agentic mode. Wider than standard RAG because the agent pools
# passages from several tools and the 12-chunk cut truncated equation chunks.
AGENT_MAX_CONTEXT_CHUNKS=20
AGENT_MAX_CONTEXT_LENGTH=80000


# ==============================================================================
# Phase 8 — Secondary LLM provider (OpenRouter)
# ==============================================================================
# OpenRouter is an OpenAI-compatible gateway. Adding it gives cross-vendor
# failover (a Google-wide outage no longer kills all LLM calls) and lets the
# user pick a model per request. Off unless OPENROUTER_API_KEY is set.
#   LLM_PROVIDER          default backend: gemini|openrouter
#   LLM_FALLBACK_PROVIDER cross-vendor fallback when the primary is exhausted
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openrouter
# Get a key at https://openrouter.ai/keys . Paid, no free tier.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Models offered in the UI dropdown (comma-separated). Bare name -> Gemini;
# slug with "/" -> OpenRouter. First entry is the default. Off-allowlist
# requests are rejected server-side.
# Keep at least one "/" slug in this list: cross-vendor failover picks the first
# OpenRouter slug here. With a Gemini-only list there is no cross-vendor hop,
# and a Google-wide outage takes every attempt down with it.
LLM_SELECTABLE_MODELS=gemini-3.6-flash,gemini-3.5-flash,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,openai/gpt-oss-20b:free
# How long the enriched OpenRouter model catalog is cached (seconds).
MODELS_CACHE_TTL=3600


# ==============================================================================
# Phase 2 — Confidence + Abstention
# ==============================================================================
# Aggregate a per-answer confidence (faithfulness + completeness + citation
# coverage) and emit an explicit "insufficient evidence" answer when the corpus
# is grounded but incomplete.
ANSWER_CONFIDENCE_ENABLE=true
# Abstain when a grounded answer's completeness falls below this floor.
ABSTAIN_COMPLETENESS_FLOOR=0.5


# ==============================================================================
# Phase 3 — Multimodal Figure/Table Indexing
# ==============================================================================
# On: ingest extracts figure/table crops, has the Gemini VLM describe each, and
# indexes "caption + description" as chunks in the same collection. Off by
# default — one VLM call per figure at ingest, bounded by
# MULTIMODAL_MAX_FIGS_PER_DOC.
ENABLE_MULTIMODAL_INGEST=false
MULTIMODAL_MAX_FIGS_PER_DOC=12


# ==============================================================================
# Phase 5 — Contradiction Detection
# ==============================================================================
# On: the answer generator runs pairwise NLI (the faithfulness model) over the
# top retrieved passages; if any pair contradicts above the threshold, the model
# is told to present both positions with citations. Off by default.
# NLI_CONTRADICTION_INDEX must match your NLI model's label order:
#   mDeBERTa-xnli=2, nli-deberta-v3-base=0
CONTRADICTION_DETECT_ENABLE=false
CONTRADICTION_NLI_THRESHOLD=0.6
NLI_CONTRADICTION_INDEX=2


# ==============================================================================
# Phase 6 — Topic Watches
# ==============================================================================
# When on, POST /watch registers a topic; each run does external search (arXiv /
# open-access), dedups against the corpus, ingests new papers, and stores a
# cited digest. Off by default (makes outbound calls + grows the corpus).
WATCH_ENABLE=false
WATCH_DEFAULT_CADENCE=weekly
WATCH_MAX_RESULTS=10
WATCH_POLL_INTERVAL=3600


# ==============================================================================
# Phase 7 — Literature Review Reports
# ==============================================================================
# When on, POST /report runs an async job that decomposes a topic into sections,
# synthesizes a cited section per part from the corpus, and stores a downloadable
# Markdown artifact. Off by default.
REPORT_ENABLE=false
REPORT_MAX_SECTIONS=6


# ==============================================================================
# Gemini Prompt Caching
# ==============================================================================
# gemini-3.6-flash already caches prefixes IMPLICITLY for free; this adds
# GUARANTEED caching but is billed per token-hour of storage. Leave false unless
# your system prompts clear the model's min-token cache floor.
GEMINI_CACHE_ENABLED=false
GEMINI_CACHE_TTL=3600


# ==============================================================================
# API Security (Optional — leave empty for local development)
# ==============================================================================

# Comma-separated list of valid API keys clients must send via X-API-Key header.
# If empty, the server accepts all requests without authentication.
# Each API key maps to an isolated user — data (sessions, watches, feedback)
# is scoped to the key. Use unique keys per user for multi-user deployments.
# Example: API_KEYS=alice-key-123,bob-key-456
API_KEYS=

# Admin API key for destructive operations (purge, delete). Falls back to
# API_KEYS validation when not set. Required in production for /purge/* routes.
# ADMIN_API_KEY=

# Production startup (start_server.py without --dev) refuses to boot with no
# API_KEYS. Set to 1 to explicitly allow an unauthenticated server (private
# hosts only — every endpoint, including DELETE /purge/*, becomes anonymous).
# ALLOW_UNAUTHENTICATED=1


# ==============================================================================
# Multi-User Support (Optional)
# ==============================================================================
# IndicRAG supports multiple users with isolated data. Each user is identified
# by their API key (X-API-Key header). The following data is user-scoped:
#   - Chat sessions and conversation history
#   - Topic watches (POST /watch)
#   - Feedback and ratings (POST /feedback)
#   - User preferences (GET/PUT /prefs/{user_id})

# Enable per-user preference storage (GET/PUT /prefs/{user_id}).
# When off, the /prefs endpoints return 404.
ENABLE_USER_PREFS=false

# Session configuration
# Maximum age of chat sessions before automatic eviction (hours).
SESSION_MAX_AGE_HOURS=24

# Maximum number of conversation turns retained per session (each turn = user +
# assistant message). Older turns are pruned from the front.
CHAT_HISTORY_MAX_TURNS=20

# Rate limiting is per-API-key by default (each user gets their own bucket).
# Unauthenticated traffic is rate-limited by client IP.


# ==============================================================================
# Logging
# ==============================================================================

# Verbosity level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ==============================================================================
# Embeddings + Vector Store
# ==============================================================================

# Multilingual embedding model (1024-dim). Changing this invalidates the whole
# index — re-ingest everything after a change, or retrieval silently degrades.
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ChromaDB HNSW index parameters. ef_construction and max_neighbors (M) only
# apply when the collection is FIRST created; ef_search applies per query and
# can be retuned by recreating the collection.
#   ef_search  higher = better recall, slower queries
#   M          higher = better recall, larger index
HNSW_EF_CONSTRUCTION=100
HNSW_EF_SEARCH=100
HNSW_M=16


# ==============================================================================
# Retrieval / Reranking
# ==============================================================================

# Cross-encoder reranker (BAAI/bge-reranker-v2-m3, 568M). On GPU it sharpens
# ranking cheaply; on CPU-only it adds latency. Keep ON if your machine can
# handle it, or set false to skip.
USE_RERANKER=true

# Hybrid retrieval: fuse dense (ChromaDB) with BM25 lexical search via
# Reciprocal Rank Fusion. Catches exact terms/identifiers that embeddings miss.
USE_HYBRID_SEARCH=true

# HyDE: draft a hypothetical answer with the LLM and embed THAT instead of the
# bare question. Helps multi-hop/vocabulary-gap queries; costs one extra LLM
# call per query. Off by default.
USE_HYDE=false

# ColBERT late-interaction reranking, blended with the dense score.
# COLBERT_WEIGHT is the dense-vs-ColBERT fusion weight (0..1).
USE_COLBERT_RERANK=false
COLBERT_WEIGHT=0.5

# Tag filtering (PATCH /papers tags, the UI tags box) is applied as a Python
# post-filter — ChromaDB can't match one tag inside the stored comma-joined
# string. A plain top-k fetch therefore returns NOTHING when tagged papers rank
# below the cut, so retrieval over-fetches first, filters, then narrows to
# top_k. TAGS_OVERFETCH is the multiplier; TAGS_OVERFETCH_MAX caps the widened
# fetch. Raise the multiplier if tag-scoped queries come back thin.
TAGS_OVERFETCH=10
TAGS_OVERFETCH_MAX=300

# Paper-scoped queries ("only these papers") fetch ALL chunks of the selected
# papers in document order instead of top-k, so reconstruction-style questions
# see the whole document. These caps stop a large book blowing the context.
SCOPED_MAX_CHUNKS=50
SCOPED_MAX_CONTEXT_LENGTH=120000


# ==============================================================================
# Ingestion — Metadata + Deduplication
# ==============================================================================

# Look up title/authors/year on arXiv during ingestion. Network call per paper;
# caller-supplied metadata always wins over enriched fields.
ENRICH_METADATA=true

# Skip papers already in the corpus. Three gates run in order: file hash
# (unchanged file), content hash (same body re-uploaded under a new name), then
# fuzzy title match at DEDUP_TITLE_THRESHOLD (0..1, higher = stricter).
DEDUP_PAPERS=true
DEDUP_TITLE_THRESHOLD=0.9


# ==============================================================================
# Faithfulness / NLI Verification
# ==============================================================================

# Per-claim entailment scoring of the answer against its cited chunks. Feeds the
# confidence score, the /query evidence panel, and the agent's reflexion loop.
# Default model is MULTILINGUAL so Indic-language claims are actually verified.
NLI_MODEL_NAME=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7

# Entailment class index in the model's logits — models disagree, and a wrong
# value inverts every score silently:
#   mDeBERTa-xnli (default):           0=entailment, 1=neutral, 2=contradiction
#   cross-encoder/nli-deberta-v3-base: 0=contradiction, 1=entailment, 2=neutral
NLI_ENTAILMENT_INDEX=0

# A claim scoring below this is logged as ungrounded.
FAITHFULNESS_THRESHOLD=0.5
# What to do with ungrounded claims: warn | strip | regen
FAITHFULNESS_ENFORCE=warn


# ==============================================================================
# Caching (in-process, per worker)
# ==============================================================================
# All three are in-memory TTL+LRU caches — they reset on restart and are NOT
# shared between uvicorn workers. Sizes are entry counts, TTLs are seconds.
#   llm        identical prompt+model+params -> cached completion
#   retrieval  identical unfiltered query -> cached chunks (biggest latency win)
#   tool       identical agent tool call -> cached result across reflexion loops
LLM_CACHE_SIZE=128
LLM_CACHE_TTL=600
RETRIEVAL_CACHE_SIZE=64
RETRIEVAL_CACHE_TTL=300
TOOL_CACHE_SIZE=64
TOOL_CACHE_TTL=180


# ==============================================================================
# Paths, CORS, Dev Mode
# ==============================================================================

# SQLite file holding sessions, jobs, feedback, watches, reports, query log.
# Defaults to sessions.db in the project root.
# SESSIONS_DB_PATH=

# Comma-separated browser origins allowed to call the API. Unset defaults to
# localhost:8000/8080 (dev). Set this for any real deployment — the Web UI is
# served same-origin, so you only need it for a separately hosted frontend.
# CORS_ORIGINS=https://rag.example.com

# Relaxes production startup checks in start_server.py. Never set in production.
# DEV_MODE=false


# ==============================================================================
# External API Keys (Optional)
# ==============================================================================

# Tavily web search API key for the agent's web_search tool.
# Get your key at: https://app.tavily.com
TAVILY_API_KEY=

# OpenAlex (open_access_search tool). Anonymous search is rate-limited under
# load (HTTP 503). Set a contact email to join the polite pool; set a free API
# key (https://openalex.org/rest-api) to avoid the anonymous 503s entirely.
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# Semantic Scholar API key — OpenAlex fallback source.
SEMANTIC_SCHOLAR_API_KEY=


# ==============================================================================
# Translation — Strategy B (Optional)
# ==============================================================================

# Strategy B translates non-English queries to English before retrieval,
# then translates the answer back to the original language.
# The NLLB-200 model (~2.5 GB) is downloaded automatically on first use.
# Model: facebook/nllb-200-distilled-600M
