# ==============================================================================
# IndicRAG — Environment Configuration
# Copy this file to .env and fill in the required values.
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
#
# NEVER commit .env to version control — it contains secrets.
# ==============================================================================


# ==============================================================================
# HuggingFace Hub (Optional)
# ==============================================================================
# Models (BGE-M3, reranker, NLI) are cached locally after first download. Set
# offline mode to skip HF Hub update checks on startup (faster, no HTTP log
# noise). Only enable AFTER all models are cached, or startup will fail.
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1


# ==============================================================================
# LLM — Google Gemini (REQUIRED)
# ==============================================================================

# Get your API key at: https://aistudio.google.com/app/apikey
#
# Option 1: Single key
LLM_API_KEY=your-gemini-api-key-here
#
# Option 2: Multiple keys for load balancing (round-robin).
# The agentic pipeline makes many Gemini calls per query — multiple keys
# distribute the load and avoid per-key rate limits.
# When LLM_API_KEYS is set, LLM_API_KEY is ignored.
# LLM_API_KEYS=key-one,key-two,key-three

# Model to use for answer generation.
# Recommended: gemini-3.5-flash — stable, frontier-level, fast, cost-effective.
# Alternatives:
#   gemini-3-flash-preview   Preview alias (same model)
#   gemini-2.5-pro           Higher reasoning quality, slower and more expensive
LLM_MODEL_NAME=gemini-3.5-flash
# Fallback model when primary is overloaded (503/429)
LLM_FALLBACK_MODEL=gemma-4-26b-a4b-it

# Response generation parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
AGENT_MAX_TOKENS=8192
AGENT_TIMEOUT=120
# Thinking budget: 0=off (cheapest), -1=dynamic, N=cap N thinking tokens
AGENT_THINKING_BUDGET=0
# Max sub-queries per reflexion cycle (main agent-latency lever)
AGENT_MAX_SUB_QUERIES=3


# ==============================================================================
# Phase 8 — Secondary LLM provider (OpenRouter)
# ==============================================================================
# OpenRouter is an OpenAI-compatible gateway. Adding it gives cross-vendor
# failover (a Google-wide outage no longer kills all LLM calls) and lets the
# user pick a model per request. Off unless OPENROUTER_API_KEY is set.
#   LLM_PROVIDER          default backend: gemini|openrouter
#   LLM_FALLBACK_PROVIDER cross-vendor fallback when the primary is exhausted
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openrouter
# Get a key at https://openrouter.ai/keys . Paid, no free tier.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Models offered in the UI dropdown (comma-separated). Bare name -> Gemini;
# slug with "/" -> OpenRouter. First entry is the default. Off-allowlist
# requests are rejected server-side.
LLM_SELECTABLE_MODELS=gemini-3.5-flash,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-9b-v2:free
# How long the enriched OpenRouter model catalog is cached (seconds).
MODELS_CACHE_TTL=3600


# ==============================================================================
# Phase 2 — Confidence + Abstention
# ==============================================================================
# Aggregate a per-answer confidence (faithfulness + completeness + citation
# coverage) and emit an explicit "insufficient evidence" answer when the corpus
# is grounded but incomplete.
ANSWER_CONFIDENCE_ENABLE=true
# Abstain when a grounded answer's completeness falls below this floor.
ABSTAIN_COMPLETENESS_FLOOR=0.5


# ==============================================================================
# Phase 3 — Multimodal Figure/Table Indexing
# ==============================================================================
# On: ingest extracts figure/table crops, has the Gemini VLM describe each, and
# indexes "caption + description" as chunks in the same collection. Off by
# default — one VLM call per figure at ingest, bounded by
# MULTIMODAL_MAX_FIGS_PER_DOC.
ENABLE_MULTIMODAL_INGEST=false
MULTIMODAL_MAX_FIGS_PER_DOC=12


# ==============================================================================
# Phase 5 — Contradiction Detection
# ==============================================================================
# On: the answer generator runs pairwise NLI (the faithfulness model) over the
# top retrieved passages; if any pair contradicts above the threshold, the model
# is told to present both positions with citations. Off by default.
# NLI_CONTRADICTION_INDEX must match your NLI model's label order:
#   mDeBERTa-xnli=2, nli-deberta-v3-base=0
CONTRADICTION_DETECT_ENABLE=false
CONTRADICTION_NLI_THRESHOLD=0.6
NLI_CONTRADICTION_INDEX=2


# ==============================================================================
# Phase 6 — Topic Watches
# ==============================================================================
# When on, POST /watch registers a topic; each run does external search (arXiv /
# open-access), dedups against the corpus, ingests new papers, and stores a
# cited digest. Off by default (makes outbound calls + grows the corpus).
WATCH_ENABLE=false
WATCH_DEFAULT_CADENCE=weekly
WATCH_MAX_RESULTS=10
WATCH_POLL_INTERVAL=3600


# ==============================================================================
# Phase 7 — Literature Review Reports
# ==============================================================================
# When on, POST /report runs an async job that decomposes a topic into sections,
# synthesizes a cited section per part from the corpus, and stores a downloadable
# Markdown artifact. Off by default.
REPORT_ENABLE=false
REPORT_MAX_SECTIONS=6


# ==============================================================================
# Gemini Prompt Caching
# ==============================================================================
# gemini-3.5-flash already caches prefixes IMPLICITLY for free; this adds
# GUARANTEED caching but is billed per token-hour of storage. Leave false unless
# your system prompts clear the model's min-token cache floor.
GEMINI_CACHE_ENABLED=false
GEMINI_CACHE_TTL=3600


# ==============================================================================
# API Security (Optional — leave empty for local development)
# ==============================================================================

# Comma-separated list of valid API keys clients must send via X-API-Key header.
# If empty, the server accepts all requests without authentication.
# WARNING: If set, the frontend must also send this key or all UI queries will
# fail with 401 Unauthorized.
# Example: API_KEYS=secret-key-1,secret-key-2
API_KEYS=

# Production startup (start_server.py without --dev) refuses to boot with no
# API_KEYS. Set to 1 to explicitly allow an unauthenticated server (private
# hosts only — every endpoint, including DELETE /purge/*, becomes anonymous).
# ALLOW_UNAUTHENTICATED=1


# ==============================================================================
# Logging
# ==============================================================================

# Verbosity level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# ==============================================================================
# Retrieval / Reranking
# ==============================================================================

# Cross-encoder reranker (BAAI/bge-reranker-v2-m3, 568M). On GPU it sharpens
# ranking cheaply; on CPU-only it adds latency. Keep ON if your machine can
# handle it, or set false to skip.
USE_RERANKER=true


# ==============================================================================
# External API Keys (Optional)
# ==============================================================================

# Tavily web search API key for the agent's web_search tool.
# Get your key at: https://app.tavily.com
TAVILY_API_KEY=

# OpenAlex (open_access_search tool). Anonymous search is rate-limited under
# load (HTTP 503). Set a contact email to join the polite pool; set a free API
# key (https://openalex.org/rest-api) to avoid the anonymous 503s entirely.
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# Semantic Scholar API key — OpenAlex fallback source.
SEMANTIC_SCHOLAR_API_KEY=


# ==============================================================================
# Translation — Strategy B (Optional)
# ==============================================================================

# Strategy B translates non-English queries to English before retrieval,
# then translates the answer back to the original language.
# The NLLB-200 model (~2.5 GB) is downloaded automatically on first use.
# Model: facebook/nllb-200-distilled-600M
